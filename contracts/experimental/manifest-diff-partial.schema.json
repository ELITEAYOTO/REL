{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ELITEAYOTO/REL/blob/main/contracts/experimental/manifest-diff-partial.schema.json",
  "title": "REL opt-in partial metadata observation report v0.2.0",
  "description": "Metadata deltas are observations, not verified absence/equivalence of runtime capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage",
    "observed"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0-experimental"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "left_warnings",
        "right_warnings",
        "negative_behavior_conclusions"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "partial"
          ]
        },
        "left_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "right_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_behavior_conclusions": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "left_warnings": {
                "maxItems": 0
              },
              "right_warnings": {
                "maxItems": 0
              }
            },
            "required": [
              "left_warnings",
              "right_warnings"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "else": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          }
        }
      ]
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "left_sha256",
        "right_sha256",
        "size_changed",
        "arch_changed",
        "imports",
        "import_dll_case_only",
        "exports",
        "sections",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0-experimental"
        },
        "left_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "right_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_changed": {
          "type": "boolean"
        },
        "arch_changed": {
          "type": "boolean"
        },
        "imports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "added",
            "removed"
          ],
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "import_dll_case_only": {
          "type": "boolean"
        },
        "exports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "added",
            "removed"
          ],
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "added",
            "removed",
            "changed"
          ],
          "properties": {
            "status": {
              "enum": [
                "unchanged",
                "changed",
                "ambiguous"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "unchanged",
                      "ambiguous"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "added": {
                    "maxItems": 0
                  },
                  "removed": {
                    "maxItems": 0
                  },
                  "changed": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "changed"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "anyOf": [
                  {
                    "properties": {
                      "added": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "removed": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "changed": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
