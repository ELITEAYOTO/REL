{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ELITEAYOTO/REL/blob/main/contracts/schemas/binary-manifest.schema.json",
  "title": "REL binary manifest v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binary_sha256",
    "size_bytes",
    "format",
    "arch",
    "sections",
    "imports",
    "exports",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "format": {
      "const": "PE"
    },
    "arch": {
      "type": [
        "string",
        "null"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "offset",
          "size",
          "virtual_address"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "virtual_address": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
