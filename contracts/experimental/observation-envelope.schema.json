{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ELITEAYOTO/REL/blob/main/contracts/experimental/observation-envelope.schema.json",
  "title": "REL experimental observation envelope 0.1.0",
  "description": "Contract only. No extraction engine is implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "producer",
    "scope",
    "observations",
    "evidence",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-experimental"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "format"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "const": "PE"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "backend",
        "backend_version",
        "config_sha256",
        "run_id"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "backend_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "status",
        "procedure",
        "limitations"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 128
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unsupported"
          ]
        },
        "procedure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "predicate",
          "status",
          "raw_value",
          "normalized_value",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "present",
              "absent_in_scope",
              "indeterminate"
            ]
          },
          "raw_value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "normalized_value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject_sha256",
          "location",
          "method",
          "extractor_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "start",
              "length"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "file_offset",
                  "rva",
                  "va"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "extractor_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "stage",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
